/*
 * Keyhac.rc - resources compiled into Keyhac.exe (icon, manifest, version info).
 *
 * "version_generated.h" is written by build.ps1 (from $Version /
 * keyhac/__init__.py's __version__) into the build's working directory
 * alongside a copy of this .rc, Keyhac.manifest, and Keyhac.ico (staged from
 * the committed keyhac/ui/assets/keyhac.ico), so all the relative includes
 * below resolve there.
 */
#include <windows.h>
#include "version_generated.h"

/* Application manifest (RT_MANIFEST, id 1 = the process default manifest). */
1 RT_MANIFEST "Keyhac.manifest"

/* Application icon (id 1 = the icon Explorer shows for the .exe; also what
 * puikit's default window/tray icon resolves to). */
1 ICON "Keyhac.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KEYHAC_VER_MAJOR, KEYHAC_VER_MINOR, KEYHAC_VER_PATCH, KEYHAC_VER_BUILD
 PRODUCTVERSION KEYHAC_VER_MAJOR, KEYHAC_VER_MINOR, KEYHAC_VER_PATCH, KEYHAC_VER_BUILD
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   /* U.S. English, Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "craftware"
            VALUE "FileDescription",  "Keyhac - Python-scriptable keyboard customization"
            VALUE "FileVersion",      KEYHAC_VER_STR
            VALUE "InternalName",     "Keyhac"
            VALUE "LegalCopyright",   "Copyright (c) craftware"
            VALUE "OriginalFilename", "Keyhac.exe"
            VALUE "ProductName",      "Keyhac"
            VALUE "ProductVersion",   KEYHAC_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
