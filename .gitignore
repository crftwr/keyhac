# gh's telemetry device id, written here rather than under LOCALAPPDATA when
# gh runs with a stripped environment (some sandboxed shells drop it). Stray,
# but it has to be ignored: release_preflight refuses to tag on any untracked
# file, so this would block a release rather than merely add noise.
.local/

# quality-loop's rooms and run records (make qa). They live in the checkout so
# they are findable, and are kept out of git because a room is scratch: a
# bundle copy, a transcript, an action, the evidence and the report.
# `git add -f` a room worth keeping.
cleanroom/

# make test-vm keeps each run's log and JUnit XML here (tools/vm_test.py).
temp/
